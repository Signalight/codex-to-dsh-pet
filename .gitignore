# 用户素材与构建产物（不随框架分发）
spritesheet.webp
*.webp
*.png
*.gif

# 仓库自身资源（banner 等）例外
!banner.png

# 商店展示截图（随仓库分发）
!assets/screenshots/
!assets/screenshots/*.png

# 运行时插件内置的示例桌宠素材（随插件分发，例外）
!packages/dsh-codex-pet/assets/**/*.webp
!packages/dsh-codex-pet/assets/**/*.png
!packages/dsh-codex-pet/assets/**/*.gif

# 用户配置（从 config.example.json 复制而来）
config.json

# 构建产物（node build.js 生成）
lib/client.js
config.effective.json

# 系统 / 编辑器
.DS_Store
Thumbs.db

# 本地素材暂存（不入库）
picture/
